{
  "name": "vinta-slidedeck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vinta presentation design system (site look) as a React slide deck: patterns, markdown slides, presenter mode, PDF/PPTX export and Claude artifacts",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "export": "node scripts/export-deck.mjs",
    "export:pdf": "node scripts/export-deck.mjs --format pdf",
    "export:pptx": "node scripts/export-deck.mjs --format pptx",
    "build-deck": "node scripts/build-deck.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "gallery": "node scripts/gallery.mjs --serve",
    "gallery:build": "node scripts/gallery.mjs",
    "render-clip": "node scripts/render-clip.mjs",
    "team-photos": "node scripts/team-photos.mjs",
    "sync-harness": "node scripts/sync-harness.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.2.5",
    "lucide-react": "^0.454.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
